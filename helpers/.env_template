DJANGO_ENV=development

# Generate a unique key per environment with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never reuse the same key across dev/staging/prod, and never commit a real key.
DJANGO_SECRET_KEY=django-insecure-string

SLURM_USER=string
SLURM_KEYFILE=string

# Set to True on hosts with no cluster access (e.g. public-facing demo servers):
SSH_DISABLED=False

# Allowlist of file-server origins that a stores.Cluster.http_base_url may use
# (comma-separated scheme://host[:port]). This value is admin-editable and is both
# embedded in the frontend and fetched server-side, so restricting it prevents
# content-injection / SSRF. Empty = no restriction (fine for local dev); set it on
# any public deployment. Example:
# FILESERVER_ALLOWED_HOSTS=http://localhost:8080,https://www.embrella.org
FILESERVER_ALLOWED_HOSTS=

# Host directory served by the optional demo Caddy file server.
# This is the tree mirrored to S3 for the public demo. Relative paths resolve from
# infra/, so the default points at the repo-root .scratch/tomodata. Optional.
# EMBRELLA_TOMODATA_DIR=../.scratch/tomodata

GOOGLE_SSO_CLIENT_ID=string
GOOGLE_SSO_PROJECT_ID=string
GOOGLE_SSO_CLIENT_SECRET=string
MYSQL_NAME=string
MYSQL_USER=string

# password for dev setup below, change for prod
MYSQL_PASSWORD=devaccount
MYSQL_PORT=3306

# Deposition reservation service: deployed lambda Function URL that hands out deposition/dataset IDs.
# set on staging/prod so IDs come from the portal reservation lambda.
RESERVATION_LAMBDA_URL=

# Container image registry. Leave unset for local dev (images build as
# embrella/{backend,frontend,db}). On staging/prod hosts `just deployv2` pulls
# from ghcr.io and needs a PAT with read:packages to authenticate:

# IMAGE_REGISTRY=ghcr.io/czimaginginstitute/embrella
# GHCR_USER=<github-username>
# GHCR_TOKEN=<personal-access-token>

# Delete the below line if you updated the env template.
YOUDIDNOTUPDATETHIS=1
