# native kernel overlay driver can't exec a process as a non-root in-container UID.
user  root;
worker_processes auto;
error_log  /dev/stderr warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /dev/stdout main;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 4096;
    client_max_body_size 100M;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    # Re-resolve upstream DNS on each request so container restarts (redeploys
    # via `just deployv2` recreate containers → new IPs) don't leave nginx
    # pointing at a dead IP.
    resolver ${NGINX_RESOLVER} ipv6=off valid=5s;

    server {
        listen 80;
        server_name umbrella.czbiohub.org _;

        location = /favicon.ico {
            access_log off;
            log_not_found off;
        }

        # Static files: served straight off the shared volume populated by
        # collectstatic in the backend container.
        location /static/ {
            alias /srv/staticfiles/;
            access_log off;
            expires 1h;
        }

        # ===== DJANGO BACKEND ROUTES =====
        location ~ ^/(admin|accounts|api|user|ping|version|docs|legacy|workflow|cryo_grids|processes|projects|people/v1|depositions/v1|copick|tem/v1|get_grids_by_user|get_grids_by_cassette|get_tomo_by_msi_session|available_grids|annotations)(/|$) {
            # Variable forces nginx to use the resolver instead of caching at startup.
            set $upstream_backend backend;
            proxy_pass http://$upstream_backend:8000;
            proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host             $http_host;
            proxy_redirect off;
        }

        # ===== COPICK-WEB VIEWER (separate app on the embrella network) =====
        location = /viewer/copick-web {
            return 301 /viewer/copick-web/;
        }

        location /viewer/copick-web/ {
            # Variable + rewrite: re-resolve via the resolver while preserving the
            # prefix strip the trailing-slash proxy_pass URI used to do.
            set $upstream_copick copick-web;
            rewrite ^/viewer/copick-web/(.*)$ /$1 break;
            proxy_pass http://$upstream_copick:8880;
            proxy_http_version 1.1;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        'upgrade';
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # ===== NEXT.JS FRONTEND (DEFAULT) =====
        location / {
            set $upstream_frontend frontend;
            proxy_pass http://$upstream_frontend:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        'upgrade';
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }
}
