###############################################################################
# Embrella settings                                                           #
###############################################################################

# See https://github.com/chanzuckerberg/embrella/blob/main/docs/setup/environment.md
# for all available options.

# Required. A unique secret key for session tokens and signing.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

# Public hostnames users reach Embrella at (comma-separated). Bare host = https;
# prefix http:// if not behind TLS. localhost is always allowed.
#EMBRELLA_HOSTS=embrella.example.org

# Time zone for stored/displayed times. Defaults to UTC.
#TIME_ZONE=America/Los_Angeles

###############################################################################
# Cluster                                                                     #
###############################################################################

# Set to False to submit SLURM jobs. Also enable the slurm_key mount in
# docker-compose.yml.
SSH_DISABLED=True

# Cluster user Embrella submits SLURM jobs as.
#SLURM_USER=svc.embrella

# File-server origins a cluster's http_base_url may use (comma-separated).
#FILESERVER_ALLOWED_HOSTS=https://files.example.org

###############################################################################
# Google SSO (optional)                                                       #
###############################################################################

# Email domains permitted to sign in via Google SSO (comma-separated).
#SSO_ALLOWED_DOMAINS=example.org
#GOOGLE_SSO_CLIENT_ID=
#GOOGLE_SSO_CLIENT_SECRET=
