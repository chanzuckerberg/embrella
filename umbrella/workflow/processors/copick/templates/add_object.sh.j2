#!/bin/bash

# ============================================================================
# Copick Add Object Script
# ============================================================================
# Adds pickable object definitions to an existing Copick project.
# Objects can be defined from template maps or custom MRC/MAP files.
# ============================================================================

#SBATCH --job-name=copick_add_object
{% for directive in slurm_directives -%}
{% if directive.directive.startswith('-') and not directive.directive.startswith('--') -%}
#SBATCH {{ directive.directive }} {{ directive.value }}
{% else -%}
#SBATCH {{ directive.directive }}={{ directive.value }}
{% endif -%}
{% endfor -%}

# ============================================================================
# Environment Setup
# ============================================================================
# Group-writable files/dirs so other users can launch subsequent runs in the same session.
umask 0002

ml anaconda
conda activate /hpc/projects/group.czii/conda_environments/pyczii

# ============================================================================
# Required Parameters
# ============================================================================
session="{{ session }}"
copick_session="{{ copickSession }}"
copick_run="{{ copickRunName }}"
copick_object_procrun="{{ copickRun }}"
object_name="{{ objectName }}"
object_diameter="{{ objectDiameter }}"

# ============================================================================
# Optional Parameters
# ============================================================================
template_map_name="{{ templateMapName }}"
pdb_id="{{ pdbId }}"
object_map_file="{{ objectMapFile }}"
object_voxel_size="{{ objectVoxelSize }}"

# ============================================================================
# Calculated Variables
# ============================================================================
copick_base_dir="/hpc/projects/group.czii/krios1.processing/copick/${copick_session}/${copick_run}"
copick_config="${copick_base_dir}/config.json"
copick_output_dir="/hpc/projects/group.czii/krios1.processing/copick/${session}/${copick_run}"
radius="$(echo "${object_diameter} / 2" | bc -l)"
template_maps_dir="/hpc/projects/group.czii/krios1.processing/copick/template_maps"

# ============================================================================
# Logging Setup
# ============================================================================
mkdir -p "${copick_output_dir}"

# Dynamically set log paths for this job
JOBTAG="${session}_${copick_object_procrun}_${SLURM_JOB_ID:-$$}"
LOG_OUT="${copick_output_dir}/add_object_${JOBTAG}.out"
LOG_ERR="${copick_output_dir}/add_object_${JOBTAG}.err"
exec >"${LOG_OUT}" 2>"${LOG_ERR}"

# ============================================================================
# Email Notifications
# ============================================================================
EMAIL_DOMAIN="czii.org"
MAIL_TO="${SLURM_JOB_USER:-$USER}@${EMAIL_DOMAIN}"

if [[ -n "${SLURM_JOB_ID:-}" ]]; then
  scontrol update JobId=${SLURM_JOB_ID} MailUser=${MAIL_TO} MailType=BEGIN,END,FAIL
fi

# ============================================================================
# Job Information
# ============================================================================
echo "============================================================================"
echo "Copick Add Object Job Started"
echo "============================================================================"
echo "Session: ${session}"
echo "Copick Session: ${copick_session}"
echo "Copick Run: ${copick_run}"
echo "Object Name: ${object_name}"
echo "Object Diameter: ${object_diameter} Å"
echo "Radius: ${radius} Å"
echo "============================================================================"

# ============================================================================
# Helper Functions
# ============================================================================
is_number() {
    # Check if input is a valid number.
    [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]]
}

# ============================================================================
# Template Map Resolution
# ============================================================================
# Resolve template map metadata from JSON files
# Supports both template maps (from database) and custom map files

resolved_map_file=""
resolved_voxel_size=""
resolved_pdb_id="${pdb_id}"

if [[ -n "${template_map_name}" && "${template_map_name}" != "NA" ]]; then
  # Load template map metadata from JSON
  template_map_json="${template_maps_dir}/${template_map_name}.json"

  if [[ -f "${template_map_json}" ]]; then
    echo "Loading template map: ${template_map_name}"

    # Extract map file, voxel size, and PDB ID from JSON
    resolved_map_file=$(jq -r '.map_file // empty' "${template_map_json}")
    resolved_voxel_size=$(jq -r '.voxel_size // empty' "${template_map_json}")
    template_pdb_id=$(jq -r '.pdb_id // empty' "${template_map_json}")

    # Use template PDB ID if user didn't provide one
    if [[ -z "${resolved_pdb_id}" || "${resolved_pdb_id}" == "NA" ]]; then
      resolved_pdb_id="${template_pdb_id}"
    fi

    echo "  Map file: ${resolved_map_file}"
    echo "  Voxel size: ${resolved_voxel_size} Å"
    echo "  PDB ID: ${resolved_pdb_id}"
  else
    echo "WARNING: Template map JSON not found: ${template_map_json}"
  fi
fi

# Override with custom map file if provided
if [[ -n "${object_map_file}" && "${object_map_file}" != "NA" ]]; then
  echo "Using custom map file: ${object_map_file}"
  resolved_map_file="${object_map_file}"
  resolved_voxel_size="${object_voxel_size}"
fi

# ============================================================================
# Build Copick Command
# ============================================================================
# Construct copick add object command with required and optional parameters

cmd="copick add object \
  --config \"${copick_config}\" \
  --name \"${object_name}\" \
  --object-type particle \
  --radius ${radius}"

# Append optional parameters if provided
if [[ -n "${resolved_pdb_id}" && "${resolved_pdb_id}" != "NA" ]]; then
  cmd+=" --pdb-id \"${resolved_pdb_id}\""
fi

if [[ -n "${resolved_map_file}" && -f "${resolved_map_file}" ]]; then
  cmd+=" --volume \"${resolved_map_file}\""

  if [[ -n "${resolved_voxel_size}" ]] && is_number "${resolved_voxel_size}"; then
    cmd+=" --voxel-size ${resolved_voxel_size}"
  else
    echo "WARNING: Voxel size not numeric or not provided; skipping voxel-size parameter"
  fi
elif [[ -n "${resolved_map_file}" ]]; then
  echo "WARNING: Map file specified but not found: ${resolved_map_file}"
fi

# ============================================================================
# Execute Command
# ============================================================================
echo "============================================================================"
echo "Running: ${cmd}"
echo "============================================================================"

eval "${cmd}"

# ============================================================================
# Check Exit Status
# ============================================================================
exit_code=$?
if [[ ${exit_code} -eq 0 ]]; then
  echo "============================================================================"
  echo "Copick Add Object Job Completed Successfully"
  echo "============================================================================"
else
  echo "============================================================================"
  echo "ERROR: Copick Add Object Job Failed with exit code ${exit_code}"
  echo "============================================================================"
  exit ${exit_code}
fi
