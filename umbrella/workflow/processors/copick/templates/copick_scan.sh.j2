#!/bin/bash

# Copick scan: enumerate a project's picks/segmentations/meshes, aggregate by copick_ref,
# and write scan.json beside config.json .

#SBATCH --job-name=copick_scan
{% for directive in slurm_directives -%}
{% if directive.directive.startswith('-') and not directive.directive.startswith('--') -%}
#SBATCH {{ directive.directive }} {{ directive.value }}
{% else -%}
#SBATCH {{ directive.directive }}={{ directive.value }}
{% endif -%}
{% endfor -%}

# Group-writable so scan.json is readable/overwritable by later runs in the session.
umask 0002

ml anaconda
conda activate {{ copickEnv }}

config_path="{{ configPath }}"
out_path="{{ scanOutPath }}"
session="{{ session }}"
run="{{ run }}"

python3 - "$config_path" "$out_path" "$session" "$run" <<'PY'
import json
import os
import sys

config_path, out_path, msi_session, msi_run = sys.argv[1:5]


def _ref(obj, user_id, session_id):
    """Stable annotation identity: "<object>:<user_id>/<session_id>" (matches the copick-web URL shape)."""
    return "%s:%s/%s" % (obj or "", user_id or "", session_id or "")


# Aggregate by (kind, copick_ref): one row per distinct identity across all runs.
# Also track distinct run names that carry any annotation — the annotated-count
# endpoint needs run names, which the copick_ref aggregation collapses away.
agg = {}
annotated_runs = set()


def _add(kind, obj, obj_id, user_id, session_id, run_name, count):
    annotated_runs.add(run_name)
    key = (kind, _ref(obj, user_id, session_id))
    entry = agg.get(key)
    if entry is None:
        entry = {
            "copick_kind": kind,
            "copick_ref": _ref(obj, user_id, session_id),
            "object_name": obj or "",
            # Ontology id from the config's pickable_objects (GO/UniProtKB/CHEBI/…)
            "object_id": obj_id or "",
            "run_count": 0,
            "total_count": 0,
            # filtered to the runs the deposited AreTomo run produced.
            "runs": [],
        }
        agg[key] = entry
    entry["run_count"] += 1
    if run_name not in entry["runs"]:
        entry["runs"].append(run_name)
    # Only picks have point counts; segmentations/meshes stay at 0.
    if count:
        entry["total_count"] += count


warnings = []
try:
    import copick

    root = copick.from_file(config_path)
    # object_name -> ontology identifier, from the config ,
    id_map = {getattr(o, "name", None): getattr(o, "identifier", None) for o in (root.pickable_objects or [])}
except Exception as exc: 
    out = {"scanned": False, "error": str(exc), "session": msi_session, "run": msi_run, "config_path": config_path}
else:
    runs = list(root.runs)
    total_runs = len(runs)
    # Emit progress every ~4% so the web UI can show "N of M runs" while the job runs.
    step = max(1, total_runs // 25)

    def _write_progress(done):
        prog = {"scanned": False, "pending": True, "progress_done": done, "progress_total": total_runs}
        tmp = out_path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(prog, fh)
        os.replace(tmp, out_path)

    _write_progress(0)
    for i, run in enumerate(runs, start=1):
        rn = run.name
        try:
            for p in run.picks or []:
                pts = getattr(p, "points", None)
                name = getattr(p, "pickable_object_name", None)
                _add("picks", name, id_map.get(name), p.user_id, p.session_id, rn,
                     len(pts) if pts is not None else 0)
            for s in run.segmentations or []:
                name = getattr(s, "name", None)
                _add("segmentations", name, id_map.get(name), s.user_id, s.session_id, rn, 0)
            for m in run.meshes or []:
                name = getattr(m, "pickable_object_name", None) or getattr(m, "name", None)
                _add("meshes", name, id_map.get(name), m.user_id, m.session_id, rn, 0)
        except Exception as exc:  # noqa: BLE001 - one bad run must not sink the whole scan
            warnings.append("%s: %s" % (rn, exc))
        if i % step == 0 or i == total_runs:
            _write_progress(i)
    for v in agg.values():
        v["runs"].sort()  # deterministic order for the UI chip
    out = {
        "scanned": True,
        "session": msi_session,
        "run": msi_run,
        "config_path": config_path,
        "picks": [v for v in agg.values() if v["copick_kind"] == "picks"],
        "segmentations": [v for v in agg.values() if v["copick_kind"] == "segmentations"],
        "meshes": [v for v in agg.values() if v["copick_kind"] == "meshes"],
        "annotated_runs": sorted(annotated_runs),
    }
    if warnings:
        out["warnings"] = warnings

# Atomic write so a caddy reader never sees a half-written file.
tmp_path = out_path + ".tmp"
with open(tmp_path, "w") as fh:
    json.dump(out, fh)
os.replace(tmp_path, out_path)
print("copick scan wrote %s" % out_path)
PY

echo "Copick scan completed."
