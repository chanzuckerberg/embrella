DJANGO_ENV=development
SECRET_KEY=django-insecure-string
SLURM_USER=string
SLURM_KEYFILE=string
GOOGLE_SSO_CLIENT_ID=string
GOOGLE_SSO_PROJECT_ID=string
GOOGLE_SSO_CLIENT_SECRET=string
MYSQL_NAME=string
MYSQL_USER=string

# password for dev setup below, change for prod

MYSQL_PASSWORD=devaccount
MYSQL_PORT=3306

# Container image registry. Leave unset for local dev (images build as

# embrella/{backend,frontend,db}). On staging/prod hosts `just deployv2` pulls

# from ghcr.io and needs a PAT with read:packages to authenticate:

# IMAGE_REGISTRY=ghcr.io/czimaginginstitute/embrella

# GHCR_USER=<github-username>

# GHCR_TOKEN=<personal-access-token>

# Delete the below line if you updated the env template.

YOUDIDNOTUPDATETHIS=1
