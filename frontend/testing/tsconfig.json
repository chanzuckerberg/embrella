{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@e2e/*": ["./*"],
      "@app/*": ["../app/*"]
    },
    "target": "ES2018",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "playwright-report"]
}
