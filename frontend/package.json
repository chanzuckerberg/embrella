{
  "name": "create-sds-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "idetik/packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "next lint && yarn prettier --check . && yarn tsc",
    "fix": "next lint --fix && yarn prettier --write .",
    "test": "jest --runInBand",
    "bootstrap:submodule": "cd idetik && npm install && npm run build && cd ../ && yarn install && yarn build",
    "e2e": "playwright test --project chromium",
    "e2e:chrome": "playwright test --project chromium",
    "e2e:ff": "playwright test --project firefox",
    "e2e:ie": "playwright test --project edge",
    "prepare": "cd .. && husky install frontend/.husky",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@czi-sds/components": "^22.6.0",
    "@czi-sds/data-viz": "^0.11.5",
    "@emotion/cache": "^11.11.0",
    "@emotion/core": "^11.0.0",
    "@emotion/css": "^11.11.2",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@idetik/core": "file:./idetik/packages/core",
    "@idetik/react": "file:./idetik/packages/react",
    "@mui/base": "5.0.0-beta.58",
    "@mui/icons-material": "5.16.7",
    "@mui/lab": "5.0.0-alpha.173",
    "@mui/material": "5.16.7",
    "@mui/material-nextjs": "^5.15.11",
    "@mui/x-date-pickers": "^8.22.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/react-table": "^8.20.5",
    "date-fns": "^3.6.0",
    "echarts": "^5.6.0",
    "lint-staged": "^15.5.2",
    "next": "^14.2.24",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.1.0",
    "react-json-view": "^1.21.3",
    "react-svg": "^16.3.0",
    "react-window": "^1.8.11",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-window": "^1",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8",
    "eslint-config-next": "^14.1.3",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsx-expressions": "^1.3.2",
    "eslint-plugin-mdx": "^2.2.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.1.0",
    "prettier-plugin-organize-imports": "^3.2.4",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-standard": "^34.0.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.1"
}
