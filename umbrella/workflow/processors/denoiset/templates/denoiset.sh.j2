#!/bin/bash

#SBATCH --job-name={{ job_name }}
{% for directive in slurm_directives -%}
{% if directive.directive.startswith('-') and not directive.directive.startswith('--') -%}
#SBATCH {{ directive.directive }} {{ directive.value }}
{% else -%}
#SBATCH {{ directive.directive }}={{ directive.value }}
{% endif -%}
{% endfor %}
#SBATCH -o {{ out_dir }}/JOB%j_denoise.out
#SBATCH -e {{ out_dir }}/JOB%j_denoise.err
{% if cluster == "czii" -%}
#SBATCH --qos=embrella
{% endif %}
# Group-writable files/dirs so other users can launch subsequent runs in the same session.
umask 0002

ml anaconda
conda activate {{ software_root }}/denoiset/pyDenoiset

# Context variables (framework-provided)
{% for var_name, var_value in context_vars.items() -%}
{{ var_name }}="{{ var_value }}"
{% endfor %}
# Calculated variables (processor-specific)
{% for var_name, var_value in calculated_vars.items() -%}
{{ var_name }}={{ var_value }}
{% endfor %}
# Schema-driven bash variables (from parameter schema)
{% for var_name, var_info in schema_vars.items() -%}
{% if var_info.format == "quoted" -%}
{{ var_name }}="{{ var_info.value }}"
{% elif var_info.format == "unquoted" -%}
{{ var_name }}={{ var_info.value }}
{% elif var_info.format == "exported" -%}
export {{ var_name }}="{{ var_info.value }}"
{% endif -%}
{% endfor %}
in_dir="{{ aretomo3_root }}/${session}/${aretomo_run}/vol001"
out_dir="{{ denoise_root }}/${session}/${denoise_run}"
model="{{ software_root }}/denoiset/denoiset/models/${model_name}"

# --- Concurrent mrc -> zarr conversion
# predict3d (--live) can idle for hours after the last volume, so zarrs are converted
# in the background. The done file tells the loop to make a final pass and exit.
zarr_wait_time=180
zarr_max_checks=960
done_file="${out_dir}/denoise_complete.txt"
mkdir -p "${out_dir}"
rm -f "${done_file}"  # stale marker from a killed run would end the loop at once

run_mrc_to_zarr() {
    conda activate {{ software_root }}/zarrczar_env
    bash {{ script_dir }}/mrc_to_zarr.sh "${out_dir}" "${done_file}" ${zarr_wait_time} ${zarr_max_checks}
}

run_mrc_to_zarr &

predict3d --model ${model} --input ${in_dir} --output ${out_dir}{% if live_denoising %} --live --t_exit 180000{% endif %}{% if use_custom_params and custom_command_line %} {{ custom_command_line }}{% endif %}
predict_status=$?

touch "${done_file}"
wait
exit ${predict_status}
