{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.86",
        "--headless",
        "--browser",
        "chromium"
      ]
    },
    "sds-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@czi-sds/mcp@latest"
      ]
    }
  }
}