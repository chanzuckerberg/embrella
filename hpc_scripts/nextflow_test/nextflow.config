/*
 * Nextflow config for Embrella cross-cluster workflow.
 * Nextflow runs locally and submits jobs to remote clusters via SSH.
 */

params {
    // SLURM scripts (override via CLI)
    aretomo3_script = '/path/to/aretomo3_job.sh'
    copick_script   = '/path/to/copick_job.sh'

    // Cluster connection
    ssh_user   = 'ddong'
    czii_host  = 'czii1'
    bruno_host = 'bruno'

    // Delay between jobs (minutes)
    wait_minutes = 20
}

// Execution report (HTML summary of the run)
report {
    enabled = true
    file    = "${launchDir}/reports/report.html"
    overwrite = true
}

// Trace file (TSV with per-process timing and status)
trace {
    enabled   = true
    file      = "${launchDir}/reports/trace.txt"
    fields    = 'task_id,name,status,exit,submit,start,complete,duration,realtime'
    overwrite = true
}

// Timeline (Gantt chart of process execution)
timeline {
    enabled = true
    file    = "${launchDir}/reports/timeline.html"
    overwrite = true
}
