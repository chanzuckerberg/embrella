{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "sds-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@czi-sds/mcp@latest"]
    }
  }
}
