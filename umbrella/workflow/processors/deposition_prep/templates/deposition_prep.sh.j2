#!/bin/bash

#SBATCH --job-name=deposition_prep
#SBATCH --mail-type=END,FAIL
{% for directive in slurm_directives -%}
{% if directive.directive.startswith('-') and not directive.directive.startswith('--') -%}
#SBATCH {{ directive.directive }} {{ directive.value }}
{% else -%}
#SBATCH {{ directive.directive }}={{ directive.value }}
{% endif -%}
{% endfor -%}
{% if cluster == "czii" %}
#SBATCH --qos=embrella
{% endif %}

# Group-writable staged tree.
umask 0002

# conda activate can clear -e and reads unset vars, so -u waits until after it.
set -e
ml anaconda
conda activate {{ prep_env }}
set -euo pipefail

output_dir={{ output_dir }}
config_path={{ config_path }}
mkdir -p -- "$output_dir"
tmp=$(mktemp "$output_dir/dataprep_config.yaml.tmp.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
cat > "$tmp" <<'{{ config_delimiter }}'
{{ config_yaml }}
{{ config_delimiter }}
# mktemp ignores umask; give the staging group read/write access before publishing.
chmod g+rw "$tmp"
mv -f -- "$tmp" "$config_path"

cd {{ output_dir }}

cryoetportalprep sync {{ config_path }}{{ session_flags }}

{% if copick_flags -%}
copick deposit --config {{ copick_config }} --target-dir {{ target_dir }} {{ copick_flags }}
{% endif -%}

{% if run_validate -%}
cryoetportalprep push {{ config_path }} --dry-run
{% endif -%}

echo "Deposition prep completed."
