#!/bin/bash

# ============================================================================
# Copick Tomogram Management Script
# ============================================================================
# Creates new Copick projects or imports tomograms to existing projects.
# Supports DCTF, SART, WBP (AreTomo3) and denoised tomograms (DenoisET).
# ============================================================================

#SBATCH --job-name=copick_tomograms
{% for directive in slurm_directives -%}
{% if directive.directive.startswith('-') and not directive.directive.startswith('--') -%}
#SBATCH {{ directive.directive }} {{ directive.value }}
{% else -%}
#SBATCH {{ directive.directive }}={{ directive.value }}
{% endif -%}
{% endfor -%}

# ============================================================================
# Environment Setup
# ============================================================================
ml anaconda
conda activate /hpc/projects/group.czii/conda_environments/pyczii

# ============================================================================
# Parameter Initialization
# ============================================================================
session="{{ session }}"
copick_procrun="{{ copickRun }}"
tomo_type="{{ importTomoType }}"
tomo_run="{{ importTomogramRun }}"
tomo_downsamplevoxel_size="{{ downsampleTomogramVoxelSize }}"

# ============================================================================
# Directory Setup
# ============================================================================
{% if operation == 'create' -%}
# Create operation: new directory based on ProcRun number
copick_dir="/hpc/projects/group.czii/krios1.processing/copick/${session}/${copick_procrun}"
mkdir -p "${copick_dir}"
{% elif operation == 'import_tomograms' -%}
# Import operation: use existing copick project directory
copick_dir="/hpc/projects/group.czii/krios1.processing/copick/${session}/{{ copickRunName }}"
{% endif -%}

# ============================================================================
# Logging Setup
# ============================================================================
# Dynamically set log paths for this job
JOBTAG="${session}_${copick_procrun}_${SLURM_JOB_ID:-$$}"
LOG_OUT="${copick_dir}/copick_tomograms_${JOBTAG}.out"
LOG_ERR="${copick_dir}/copick_tomograms_${JOBTAG}.err"
exec >"${LOG_OUT}" 2>"${LOG_ERR}"

# ============================================================================
# Email Notifications
# ============================================================================
EMAIL_DOMAIN="biohub.org"
MAIL_TO="${SLURM_JOB_USER:-$USER}@${EMAIL_DOMAIN}"

if [[ -n "${SLURM_JOB_ID:-}" ]]; then
  scontrol update JobId=${SLURM_JOB_ID} MailUser=${MAIL_TO} MailType=BEGIN,END,FAIL
fi

# ============================================================================
# Tomogram Path Mapping
# ============================================================================
# Map tomogram type to file system path based on reconstruction algorithm
case "${tomo_type,,}" in
  dctf)
    # Dose-compensated reconstruction (AreTomo3)
    tomo_path="/hpc/projects/group.czii/krios1.processing/aretomo3/${session}/${tomo_run}/vol001/*.mrc"
    ;;
  sart)
    # SART reconstruction (AreTomo3)
    tomo_path="/hpc/projects/group.czii/krios1.processing/aretomo3/${session}/${tomo_run}/vol003/*.mrc"
    ;;
  wbp)
    # Weighted back-projection reconstruction (AreTomo3)
    tomo_path="/hpc/projects/group.czii/krios1.processing/aretomo3/${session}/${tomo_run}/vol002/*.mrc"
    ;;
  denoise)
    # Denoised tomograms (DenoisET)
    tomo_path="/hpc/projects/group.czii/krios1.processing/denoise/${session}/${tomo_run}/*.mrc"
    ;;
  *)
    # Default fallback: DCTF reconstruction
    tomo_path="/hpc/projects/group.czii/krios1.processing/aretomo3/${session}/${tomo_run}/vol001/*.mrc"
    ;;
esac

{% if operation == 'create' -%}
# ============================================================================
# Create Copick Project Configuration (Create Operation Only)
# ============================================================================
# Initialize a new Copick project with filesystem overlay structure
copick config filesystem \
    --config ${copick_dir}/config.json \
    --overlay-root ${copick_dir} \
    --proj-name ${session}_copickProcRun${session}_${tomo_type}_tomoProcRun${tomo_run} \
    --proj-description "Embrella created copick processing for msi session ${session} tomogram type ${tomo_type} and tomogram processing run ${tomo_run}"

{% endif -%}
# ============================================================================
# Import Tomograms to Copick Project
# ============================================================================
# Add tomograms with path specific to tomo type
# Excludes EVN and ODD half-reconstructions (only imports full volumes)
copick add tomogram "${tomo_path}" \
  --config "${copick_dir}/config.json" \
  --tomo-type "${tomo_type,,}" \
  --run-regex '^(Position_[0-9]+(?:_[0-9]+)*)_Vol$'

# ============================================================================
# Determine Voxel Size for Downsampling
# ============================================================================
# Get smallest common voxel size across all runs for the given tomogram type
# This ensures consistent voxel spacing when downsampling
voxel_size=$(python3 - <<PY
import copick, math
from copick.ops.get import from_file, get_tomograms, get_runs

def extract_voxsize(tomo):
    """Extract voxel size from tomogram metadata."""
    # Try voxel_spacing attribute first
    vs = getattr(tomo, "voxel_spacing", None)
    if vs and hasattr(vs, "voxel_size"):
        return float(vs.voxel_size)

    # Try common attribute names
    for attr in ("voxel_size", "spacing", "voxel"):
        if hasattr(tomo, attr):
            try:
                return float(getattr(tomo, attr))
            except (TypeError, ValueError):
                pass

    # Try metadata dictionary
    meta = getattr(tomo, "meta", None)
    if isinstance(meta, dict):
        for k in ("voxel_size", "spacing", "voxel"):
            try:
                return float(meta.get(k))
            except (TypeError, ValueError):
                pass

    return None

def smallest_common_vox_for_type(config_path: str, tomo_type: str):
    """Find smallest voxel size common to all runs."""
    root = from_file(config_path)
    per_run_sets = []

    for run in get_runs(root):
        tomos = get_tomograms(root, runs=[run], tomo_type=tomo_type)
        sizes = {extract_voxsize(t) for t in tomos}
        sizes.discard(None)

        if not sizes:
            return None

        per_run_sets.append(sizes)

    # Find voxel sizes common across all runs
    common = set.intersection(*per_run_sets) if per_run_sets else set()
    return min(common) if common else None

# Execute voxel size detection
config_path = "${copick_dir}/config.json"
tomo_type = "${tomo_type}".lower()

v = smallest_common_vox_for_type(config_path, tomo_type)
if v is not None:
    print(v)
PY
)

# ============================================================================
# Downsample Tomograms (if requested)
# ============================================================================
# Only downsample if both target voxel size and detected voxel size are valid
if [[ ${tomo_downsamplevoxel_size} =~ ^[0-9]+([.][0-9]+)?$ ]] && [[ ${voxel_size} =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "Downsampling tomograms from ${voxel_size}Å to ${tomo_downsamplevoxel_size}Å..."

  copick process downsample \
    --config "${copick_dir}/config.json" \
    --tomo-alg "${tomo_type,,}" \
    --voxel-size "${voxel_size}" \
    --target-resolution "${tomo_downsamplevoxel_size}"
else
  echo "Skipping downsample: voxel_size='${voxel_size}', target='${tomo_downsamplevoxel_size}'"
fi

echo "Copick tomogram processing completed successfully!"
