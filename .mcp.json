{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless"]
    },
    "sds-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@czi-sds/mcp@latest"]
    },
    "argus": {
      "command": "argus",
      "args": ["mcp"]
    }
  }
}
