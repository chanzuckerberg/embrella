user  nginx;
worker_processes auto;
error_log  /dev/stderr warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    log_format  main  '$remote_addr - [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer"';

    access_log  /dev/stdout main;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 4096;
    client_max_body_size 100M;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    # Big values so Next.js HMR websockets stay open.
    proxy_read_timeout  3600s;
    proxy_send_timeout  3600s;

    # Re-resolve `backend` / `frontend` DNS on each request so container restarts
    # don't leave nginx pointing at a dead IP. NGINX_RESOLVER is substituted at
    # container startup by the nginx image's envsubst entrypoint.
    resolver ${NGINX_RESOLVER} ipv6=off valid=5s;

    server {
        listen 80 default_server;
        server_name _;

        location = /favicon.ico {
            access_log off;
            log_not_found off;
        }

        # Backend serves /static/ in dev (runserver does this when DEBUG=True),
        # so we just proxy it instead of bind-mounting collectstatic output.
        location ~ ^/(admin|accounts|api|user|ping|version|docs|static|legacy|workflow|cryo_grids|processes|projects|people/v1|depositions/v1|copick|tem/v1|get_grids_by_user|get_grids_by_cassette|get_tomo_by_msi_session|available_grids|annotations)(/|$) {
            # Using a variable forces nginx to use the resolver instead of caching at startup.
            set $upstream_backend backend;
            proxy_pass http://$upstream_backend:8000;
            proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host             $http_host;
            proxy_redirect off;
        }

        # ===== COPICK-WEB VIEWER (separate app on the embrella network) =====
        location = /viewer/copick-web {
            return 301 /viewer/copick-web/;
        }

        location /viewer/copick-web/ {
            # Variable + rewrite: re-resolve via the resolver while preserving the
            # prefix strip the trailing-slash proxy_pass URI used to do.
            set $upstream_copick copick-web;
            rewrite ^/viewer/copick-web/(.*)$ /$1 break;
            proxy_pass http://$upstream_copick:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        'upgrade';
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # ===== DEMO FILE SERVER (optional `caddy` service, `demo` profile) =====
        # Same-origin so the browser (zarr viewer / thumbnails) needs no CORS.
        # Mirrors the k8s `handle_path /tomodata/*` prefix strip. Only reachable
        # when the caddy service is up (`just devup-demo`).
        location /tomodata/ {
            set $upstream_caddy caddy;
            rewrite ^/tomodata/(.*)$ /$1 break;
            proxy_pass http://$upstream_caddy:80;
            proxy_set_header Host              $http_host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Next.js (yarn dev) needs websocket upgrade for HMR.
        location / {
            set $upstream_frontend frontend;
            proxy_pass http://$upstream_frontend:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        'upgrade';
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }
}
